// Horns ported from Bubberstation + NovaSector, merged into one file. No naming overlap
// between the two sources for this category.
/datum/sprite_accessory/mutant/horns/anthro
	icon = 'icons/mob/species/anthro/horns.dmi'
	species_allowed = list(SPECIES_ANTHRO)
	// See accessory_mutant_tail_anthro.dm -- ported greyscale art needs ICON_MULTIPLY, not the base class's
	// ICON_ADD default, matching Unathi's own native horns (accessory_unathi.dm).
	mutant_blend = ICON_MULTIPLY

