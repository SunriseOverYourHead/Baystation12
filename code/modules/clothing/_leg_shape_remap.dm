// Builds (and caches) a 4-directional icon with this (category, shape_key) combo's remap pixels applied to every
// direction of [state] in [source_icon]. Each entry moves (at most) one source pixel to one destination pixel --
// a source coordinate the item has no art at simply contributes nothing (transposes "as many of the original
// pixels as possible", never blocks on missing art). Returns null if this combo has no rule for any direction (a
// safe no-op, callers fall back to rendering the item normally). Lives on /obj/item (not /obj/item/clothing) --
// see leg_remap_category's declaration in items.dm for why.
/obj/item/proc/get_leg_remapped_icon(icon/source_icon, state, shape_key)
	if(!leg_remap_category)
		return null

	var/cache_key = "[source_icon]-[state]-[leg_remap_category]-[shape_key]"
	if(GLOB.leg_remap_icon_cache[cache_key])
		return GLOB.leg_remap_icon_cache[cache_key]

	// Most remap tables fit within the standard 32x32 on-mob canvas, but a few (eg GAS's elongated head/neck on
	// HELMET, dst_y up to 40) legitimately need extra headroom above it -- their reference.dmi art was painted on
	// a taller canvas for exactly this. Scan every direction's pixel table up front so the canvas is sized to fit
	// before any Blend() happens; Crop()ing it taller afterwards would just silently clip again.
	var/canvas_height = 32
	for(var/use_dir in list(SOUTH, NORTH, EAST, WEST))
		var/list/pixels = get_leg_remap_pixels(leg_remap_category, shape_key, use_dir)
		if(leg_remap_category == CLOTHING_LEG_CATEGORY_SKIRT)
			// A jumpskirt needs its jumpsuit's pixels too -- CLOTHING_LEG_CATEGORY_SKIRT's own table only holds the
			// extra pixels a skirt needs on top of that (see the SKIRT block in get_leg_remap_pixels()).
			var/list/pants_pixels = get_leg_remap_pixels(CLOTHING_LEG_CATEGORY_PANTS, shape_key, use_dir)
			if(pants_pixels)
				pixels = pixels ? (pants_pixels + pixels) : pants_pixels
		for(var/list/entry in pixels)
			if(entry[4] > canvas_height)
				canvas_height = entry[4]

	var/icon/result = new /icon('icons/mob/human_races/species/template.dmi')
	if(canvas_height > 32)
		// Crop() with a taller y2 pads the new rows with transparency and keeps the original bottom-left
		// anchor -- content already positioned at y=1..32 doesn't shift, it just gains headroom above it.
		result.Crop(1, 1, 32, canvas_height)
	var/built_anything = FALSE

	for(var/use_dir in list(SOUTH, NORTH, EAST, WEST))
		var/list/pixels = get_leg_remap_pixels(leg_remap_category, shape_key, use_dir)
		if(leg_remap_category == CLOTHING_LEG_CATEGORY_SKIRT)
			var/list/pants_pixels = get_leg_remap_pixels(CLOTHING_LEG_CATEGORY_PANTS, shape_key, use_dir)
			if(pants_pixels)
				pixels = pixels ? (pants_pixels + pixels) : pants_pixels
		var/icon/canvas = new /icon('icons/mob/human_races/species/template.dmi')
		if(canvas_height > 32)
			canvas.Crop(1, 1, 32, canvas_height)
		if(pixels)
			var/icon/source = new(source_icon, icon_state = state, dir = use_dir)
			for(var/list/entry in pixels)
				var/icon/pixel = new(source)
				pixel.Crop(entry[1], entry[2], entry[1], entry[2])
				canvas.Blend(pixel, ICON_OVERLAY, entry[3], entry[4])
			built_anything = TRUE
		else
			// No rule for this direction -- fall back to the unmodified sprite so the item never renders blank.
			canvas.Blend(new/icon(source_icon, icon_state = state, dir = use_dir), ICON_OVERLAY, 1, 1)
		result.Insert(canvas, dir = use_dir)

	if(!built_anything)
		return null

	GLOB.leg_remap_icon_cache[cache_key] = result
	return result
